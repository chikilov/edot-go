# 이 파일을 deploy/cloud/.env 로 복사하고 로컬 편집기에서 값을 채우세요.
# Elastic Cloud의 Add data > OpenTelemetry 안내에서 복사한 Managed OTLP endpoint.
# Elasticsearch URL이나 Kibana URL을 넣지 마세요. /v1/traces 등은 붙이지 않습니다.
OTEL_EXPORTER_OTLP_ENDPOINT='https://YOUR_MANAGED_OTLP_ENDPOINT'
# 안내 화면에서 발급한 수집용 API Key의 encoded 값. <> 없이 교체합니다.
# ApiKey 뒤의 %20은 공백을 URL 인코딩한 값입니다.
OTEL_EXPORTER_OTLP_HEADERS='Authorization=ApiKey%20YOUR_ENCODED_API_KEY'
OTEL_EXPORTER_OTLP_PROTOCOL='http/protobuf'
OTEL_SERVICE_NAME='edot-go-cloudcheck'
OTEL_RESOURCE_ATTRIBUTES='deployment.environment.name=cloud-validation'
OTEL_EXPORTER_OTLP_TIMEOUT='10000'
EDOT_GO_RUNTIME_METRICS_ENABLED='false'
