# Serverless has no user-selected Stack version. Do not set ELASTIC_STACK_VERSION.
ELASTIC_DEPLOYMENT='serverless'
OTEL_EXPORTER_OTLP_ENDPOINT='https://YOUR_SERVERLESS_MANAGED_OTLP_ENDPOINT'
OTEL_EXPORTER_OTLP_HEADERS='Authorization=ApiKey%20YOUR_ENCODED_INGESTION_KEY'
OTEL_EXPORTER_OTLP_PROTOCOL='http/protobuf'
EDOT_GO_RUNTIME_METRICS_ENABLED='false'
