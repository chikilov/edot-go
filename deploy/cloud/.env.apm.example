# Elastic Cloud Hosted 8.19: Cloud Manage 화면의 APM URL.
OTEL_EXPORTER_OTLP_ENDPOINT='https://YOUR_APM_ENDPOINT'
# Kibana Applications/APM > Settings > Agent keys에서 event:write 권한으로 발급.
OTEL_EXPORTER_OTLP_HEADERS='Authorization=ApiKey%20YOUR_BASE64_ENCODED_APM_AGENT_KEY'
# 기존 APM secret token을 사용하는 경우 위 줄 대신 아래 형식을 사용합니다.
# OTEL_EXPORTER_OTLP_HEADERS='Authorization=Bearer%20YOUR_EXISTING_APM_SECRET_TOKEN'
OTEL_EXPORTER_OTLP_PROTOCOL='http/protobuf'
OTEL_SERVICE_NAME='edot-go-cloudcheck'
OTEL_RESOURCE_ATTRIBUTES='deployment.environment.name=cloud-validation'
OTEL_EXPORTER_OTLP_TIMEOUT='10000'
EDOT_GO_RUNTIME_METRICS_ENABLED='false'
# 실제 저장까지 자동 조회하려면 Cloud Manage의 Elasticsearch URL을 선택적으로 설정.
# 기존 API Key에 read 권한이 없으면 자동 조회는 미검증으로 남습니다.
# ELASTICSEARCH_URL='https://YOUR_ELASTICSEARCH_ENDPOINT'
# Elasticsearch URL 대신 Kibana의 origin 주소로도 조회할 수 있습니다 (/app/... 제외).
# KIBANA_URL='https://YOUR_KIBANA_ENDPOINT'
